{
  "name": "vidmage",
  "private": true,
  "version": "0.0.0",
  "description": "Public VIDMAGE integration workbench, evidence-first genesis",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify:donors": "node scripts/check-donors.mjs",
    "band-iq:proof": "python3 -m unittest -v tests/test_band_iq.py tests/test_band_iq_donors.py",
    "band-iq:capabilities": "python3 -m bridge.band_iq_donors capabilities",
    "band-iq:film-proof": "python3 -m unittest -v tests/test_band_iq_film_loop.py",
    "band-iq:film-help": "python3 -m bridge.band_iq_film_loop --help",
    "band-iq:playdeck-proof": "python3 -m unittest -v tests/test_band_iq_playdeck_native.py",
    "band-iq:playdeck-help": "python3 -m bridge.band_iq_playdeck_native --help",
    "band-iq:review-proof": "python3 -m unittest -v tests/test_band_iq_review.py",
    "band-iq:review-room": "python3 -m bridge.band_iq_review --help",
    "band-iq:question-proof": "python3 -m unittest -v tests/test_band_iq_next_question.py",
    "band-iq:question-help": "python3 -m bridge.band_iq_next_question --help",
    "band-iq:lab-proof": "python3 -m unittest -v tests/test_band_iq_question_lab.py",
    "band-iq:lab-help": "python3 -m bridge.band_iq_question_lab --help",
    "band-iq:ac-proof": "python3 -m unittest -v tests/test_band_iq_ac_review.py",
    "band-iq:ac-room": "python3 -m bridge.band_iq_ac_review --help",
    "band-iq:workbench-proof": "python3 -m unittest -v tests/test_band_iq_workbench.py",
    "band-iq:workbench": "python3 -m bridge.band_iq_workbench --help",
    "band-iq:porch-proof": "python3 -m unittest -v tests/test_band_iq_front_porch.py",
    "band-iq:porch": "python3 -m bridge.band_iq_front_porch --help",
    "band-iq:storytable-proof": "python3 -m unittest -v tests.test_band_iq_storytable",
    "band-iq:filmstrip-proof": "python3 -m unittest -v tests.test_band_iq_living_filmstrip",
    "band-iq:contact-proof": "python3 -m unittest -v tests.test_band_iq_contact_sheet",
    "band-iq:cross-proof": "python3 -m unittest -v tests.test_band_iq_cross_bits"
  }
}
