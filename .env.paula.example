# Copy to .env.paula and keep private: chmod 600 .env.paula
PAULA_AUTH_MODE=cloudflare
PAULA_CF_TEAM_DOMAIN=https://YOURTEAM.cloudflareaccess.com
PAULA_CF_AUD=PASTE_APPLICATION_AUDIENCE_TAG
# Authorized user emails ONLY, separated by commas. Paula signs in with one of them.
PAULA_ALLOWED_EMAILS=paula@example.com
# Optional, paid Cloudflare Browser Run. Omit these two for ordinary Flow deep link.
#PAULA_BROWSER_ACCOUNT_ID=YOUR_ACCOUNT_ID
#PAULA_BROWSER_API_TOKEN=YOUR_LIMITED_BROWSER_RUN_TOKEN

# Label and navigation are public (NOT credentials). Give the two machines
# different values for NODE_LABEL but the same two HTTPS destination URLs.
PAULA_NODE_LABEL=Home studio
PAULA_HOME_URL=https://paula-home.YOURDOMAIN.example
PAULA_AWS_URL=https://paula-aws.YOURDOMAIN.example
